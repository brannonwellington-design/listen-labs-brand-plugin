    "method": "Synthetic coding of every interview, each code backed by a quote."
  },
  "arrival": {
    "code": "easy_start",
    "on": "Started easily",
    "off": "No easy start in their words",
    "lastLabel": "last visit",
    "endLabel": "order collected"
  },
  "stations": [
    {
      "key": "start",
      "name": "Starting",
      "prop": "hopper",
      "count": 13,
      "code": "easy_start",
      "statement": "found it easy to start",
      "readout": "found it easy",
      "implication": "(Synthetic implication for this stage.)",
      "quote": "(Synthetic example quote about starting.)",
      "source": "https://listenlabs.ai/response/00000000-0000-0000-0002-000000000000?message=6#a-6"
    },
    {
      "key": "browse",
      "name": "Browsing",
      "prop": "bin-rack",
      "count": 7,
      "code": "browsed",
      "statement": "browsed the menu before choosing",
      "readout": "browsed first",
      "implication": "(Synthetic implication for this stage.)",
      "quote": "(Synthetic example quote about browsing.)",
      "source": "https://listenlabs.ai/response/00000000-0000-0000-0002-000000000001?message=6#a-6"
    },
    {
      "key": "price",
      "name": "Price check",
      "prop": "labeler",
      "count": 11,
      "code": "price_check",
      "statement": "stopped to check the price",
      "readout": "checked the price",
      "implication": "(Synthetic implication for this stage.)",
      "quote": "(Synthetic example quote about price check.)",
      "source": "https://listenlabs.ai/response/00000000-0000-0000-0002-000000000002?message=6#a-6"
