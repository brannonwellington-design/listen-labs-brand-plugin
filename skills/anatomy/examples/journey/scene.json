    {
      "key": "leave",
      "name": "Leaving",
      "prop": "threshold-gate",
      "count": 4,
      "code": "left",
      "statement": "left without ordering at least once",
      "readout": "left once",
      "implication": "(Synthetic implication for this stage.)",
      "quote": "(Synthetic example quote about leaving.)",
      "source": "https://listenlabs.ai/response/00000000-0000-0000-0002-000000000003?message=6#a-6"
    }
  ],
  "assert": [
    "stations.start.count > study.n * 0.5"
  ],
  "figure": {
    "fig": "Fig 1",
    "title": "Ordering ahead",
    "hint": "Hover a gauge \u00b7 click it for quotes",
    "label": "An isometric conveyor with four stations; a gauge at each reads how many of the {study.n} interviews mention that stage.",
    "caption": "Each gauge reads its stage's count of {study.n} interviews. Follow one respondent to see the stages their own words support.",
    "titleBlock": [
      [
        "Drawing",
        "Example conveyor"
      ],
      [
        "Study",
        "Example \u00b7 synthetic"
      ],
      [
        "Base",
        "n = {study.n}"
      ],
      [
        "Method",
        "Synthetic data"
      ],
      [
        "Scale",
        "gauge = count of n"
      ]
    ]
  },
  "tension": {
    "label": "Some leave before ordering",
    "event": "stall",
    "target": {
      "station": "leave"
    },
    "numbers": [
      "@stations.leave.finding"
    ]
  },
  "page": {
    "frame": "Example study \u00b7 {study.n} synthetic interviews",
    "headline": "An example journey, built from synthetic data",
    "dek": "This page is built from the example config in examples/journey.",
    "who": {
      "one": "customer",
      "many": "customers"
    },
    "stop": {
      "on": "Mentioned here",
      "off": "Not mentioned here",
      "at": "mentioned"
    },
    "headlineStats": [
