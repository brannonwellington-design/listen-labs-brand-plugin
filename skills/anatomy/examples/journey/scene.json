{
  "_example": "Synthetic: a fictional caf\u00e9-app study for learning the journey config (references/patterns.md, 'Journey config'). Copy into scenes/<slug>/ and replace everything.",
  "pattern": "journey",
  "world": "conveyor",
  "study": {
    "id": "00000000-example-journey",
    "title": "Example: ordering ahead",
    "url": "https://listenlabs.ai/p/example-journey",
    "n": 16
  },
  "people": {
    "filter": [
      {
        "complete": true
