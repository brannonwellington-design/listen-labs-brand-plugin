  },
  "scripts": {
    "tour": {
      "title": "The tour",
      "beats": [
        {
          "hold": 5,
          "camera": "wide",
          "title": "Four stages",
          "caption": "@page.dek"
        },
        {
          "hold": 5,
          "station": "start",
          "title": "Starting",
          "caption": "@stations.start.finding",
          "quote": "@stations.start.quote"
        },
        {
          "hold": 6,
          "station": "leave",
          "title": "Leaving",
          "caption": "@stations.leave.finding"
        }
      ]
    }
  }
