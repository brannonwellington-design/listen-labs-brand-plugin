#!/usr/bin/env bash
# Auto-sync generated outputs from brand data before every commit.

REPO_DIR="$(git rev-parse --show-toplevel)"

if git diff --cached --name-only | grep -qE "^(brand_data\.py|generate_guidelines\.py)$"; then
    echo "Brand data or generator changed — regenerating GUIDELINES.md..."
    python3 "$REPO_DIR/generate_guidelines.py"
    git add "$REPO_DIR/GUIDELINES.md"
    echo "GUIDELINES.md synced and staged."
fi

if git diff --cached --name-only | grep -qE "^(brand_data\.py|generate_site\.py|templates/|assets/)"; then
    echo "Brand data, site generator, template, or assets changed — regenerating docs/..."
    python3 "$REPO_DIR/generate_site.py"
    git add "$REPO_DIR/docs"
    echo "docs/ synced and staged."
fi
